# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Clerk (https://dashboard.clerk.com) ---
# Pre-launch: this app uses Clerk's native Waitlist mode, no database of
# our own needed. In the Clerk Dashboard, go to User & Authentication ->
# Restrictions and set "Sign-up mode" to "Waitlist" so people who join
# via /waitlist are queued there (visible under Dashboard -> Waitlist).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_WAITLIST_URL=/waitlist
