# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/alerts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/alerts

# --- Postgres (Vercel Postgres / Neon — provision from the Vercel dashboard,
# then "Connect Store" to this project; Vercel injects POSTGRES_URL for you) ---
POSTGRES_URL=
