# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/alerts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/alerts

# --- Postgres (Neon via Vercel Storage tab — connect it to this project and
# Vercel injects the connection string for you, usually as DATABASE_URL;
# older Vercel Postgres integrations use POSTGRES_URL instead — lib/db.js
# checks both, so you only need whichever one Vercel actually sets) ---
DATABASE_URL=
